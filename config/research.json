{
  "defaultProgram": "skills/research/program.md",
  "defaultProfile": "standard",
  "defaultProvider": null,
  "defaults": {
    "maxIterations": 10,
    "maxTokens": 200000,
    "noProgress": 2,
    "scoreThreshold": 80,
    "retryCount": 1,
    "maxSearches": 20,
    "maxFetches": 20
  },
  "profiles": {
    "quick": {
      "minRounds": 3,
      "maxRounds": 3,
      "minSources": 15,
      "maxScouts": 3,
      "maxFetchers": 1,
      "verification": []
    },
    "standard": {
      "minRounds": 5,
      "maxRounds": 5,
      "minSources": 30,
      "maxScouts": 8,
      "maxFetchers": 4,
      "verification": []
    },
    "intermediate": {
      "minRounds": 10,
      "maxRounds": 10,
      "minSources": 40,
      "maxScouts": 12,
      "maxFetchers": 6,
      "verification": []
    },
    "deep": {
      "minRounds": 20,
      "maxRounds": 20,
      "minSources": 250,
      "maxScouts": 32,
      "maxFetchers": 16,
      "verification": []
    },
    "open-ended": {
      "minRounds": 5,
      "maxRounds": null,
      "minSources": 30,
      "maxScouts": 8,
      "maxFetchers": 4,
      "verification": []
    }
  },
  "roles": {},
  "capabilities": {
    "web-search": {
      "name": "web-search",
      "paths": ["../extensions/web-search/index.ts"],
      "requiredTools": ["web_lookup", "fetch_web"]
    },
    "subagent": {
      "name": "subagent",
      "paths": ["../extensions/subagent/index.ts"],
      "requiredTools": ["write", "read"]
    }
  },
  "childExtensions": [
    "../extensions/web-search/index.ts",
    "../extensions/subagent/index.ts"
  ]
}
